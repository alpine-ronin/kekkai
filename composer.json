{
    "name": "alpine-ronin/kekkai",
    "description": "Makes an AI coding agent's diff reviewable: the agent declares what it will change, edits outside that are refused, the diff is reviewed before it stops",
    "type": "library",
    "keywords": [
        "ai",
        "agent",
        "guardrails",
        "scope",
        "mcp",
        "claude-code",
        "cursor",
        "hooks",
        "code-review",
        "ddd",
        "phpgraph"
    ],
    "homepage": "https://github.com/alpine-ronin/kekkai",
    "license": "MIT",
    "authors": [
        {
            "name": "Houssem Eddine BENABDALLAH",
            "email": "benabdallahhoussemedine@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/alpine-ronin/kekkai/issues",
        "source": "https://github.com/alpine-ronin/kekkai"
    },
    "require": {
        "php": ">=8.3",
        "symfony/console": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "opis/json-schema": "^2.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kekkai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kekkai\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kekkai"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ],
        "phar": "@php -d phar.readonly=0 tools/build-phar.php",
        "smoke": "tools/smoke.sh bin/kekkai"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
